allow-bool TERMITE_METAL_DISABLE_GEMMA_GATED_MLP_TRAINING_GRAPH_FUSION
allow-bool TERMITE_METAL_ENABLE_GEMMA_GATED_MLP_TRAINING_GRAPH_FUSION
allow-bool TERMITE_METAL_DISABLE_ATTENTION_OUTPUT_RESIDUAL_GRAPH_FUSION
