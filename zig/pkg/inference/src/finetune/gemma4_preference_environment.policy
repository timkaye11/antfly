allow-bool TERMITE_METAL_DISABLE_LORA_BACKWARD_RUNTIME_REGION
allow-bool TERMITE_METAL_ENABLE_LORA_BACKWARD_RUNTIME_REGION
allow-bool TERMITE_METAL_DISABLE_LOW_RANK_LORA_BACKWARD_RUNTIME_REGION
allow-bool TERMITE_METAL_ENABLE_LOW_RANK_LORA_BACKWARD_RUNTIME_REGION
allow-bool TERMITE_METAL_DISABLE_RANK_ADAPTER_BACKWARD_RUNTIME_REGION
allow-bool TERMITE_METAL_ENABLE_RANK_ADAPTER_BACKWARD_RUNTIME_REGION
allow-bool TERMITE_METAL_DISABLE_FFN_GELU_BACKWARD_RUNTIME_REGION
allow-bool TERMITE_METAL_ENABLE_FFN_GELU_BACKWARD_RUNTIME_REGION
allow-bool TERMITE_METAL_DISABLE_GATED_GELU_BACKWARD_FUSION
allow-bool TERMITE_METAL_ENABLE_GATED_GELU_BACKWARD_FUSION
allow-bool TERMITE_METAL_DISABLE_GATED_GELU_FORWARD_FUSION
