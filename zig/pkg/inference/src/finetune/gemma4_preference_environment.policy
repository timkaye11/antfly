# Gemma4 preference-training environment policy, version 2.
#
# Directives:
#   scope-prefix PREFIX
#   sanitize-prefix PREFIX
#   sanitize-exact NAME
#   strict NAME VALUE
#   deny NAME
#   allow-bool NAME
#   allow-presence NAME
#   allow-uint NAME
#   allow-uint-range NAME MIN MAX
#   allow-fixed NAME VALUE
#
# This file is embedded by the Zig product boundary and read directly by the
# Python qualification harnesses. Keep semantic/debug controls here instead of
# maintaining language-specific allowlists.
#
# GRPO sampling/objective controls and DPO loss/label-smoothing controls are
# deliberately typed recipe fields, not environment overrides, so their values
# are fingerprinted and resume-safe.

scope-prefix TERMITE_METAL_
scope-prefix TERMITE_GEMMA4_
scope-prefix TERMITE_DISABLE_
scope-prefix TERMITE_ENABLE_
scope-prefix TERMITE_GRAPH_
scope-prefix TERMITE_QUANT_
scope-prefix TERMITE_DEBUG_
scope-prefix TERMITE_TRAINING_GRAPH_EXECUTOR_
scope-prefix ANTFLY_GEMMA4_DPO_
scope-prefix ANTFLY_GEMMA4_GRPO_
scope-prefix ANTFLY_GEMMA4_PREFERENCE_

# Qualification starts from an environment with every Termite and Gemma4
# override removed, then installs only the strict bindings below.
sanitize-prefix TERMITE_
sanitize-prefix ANTFLY_GEMMA4_
sanitize-exact ANTFLY_EXPERIMENTAL_GEMMA4_GGUF_QLORA

strict TERMITE_ENABLE_TRAINING_GRAPH_EXECUTOR 1
strict TERMITE_DISABLE_TRAINING_GRAPH_EXECUTOR 0
strict TERMITE_TRAINING_GRAPH_EXECUTOR_PARITY_CHECK 0
strict TERMITE_DEBUG_DEVICE_GRAD_NORM 0

# Correctness and route-selection kill switches are never admitted in product
# preference runs, even when their value appears harmless.
deny TERMITE_ENABLE_CUT_LINEAR_CROSS_ENTROPY
deny TERMITE_TRAINING_GRAPH_EXECUTOR_PARITY_NODE_IDS
deny TERMITE_DISABLE_GRAPH_OUTPUT_OWNED_COPY
deny TERMITE_DISABLE_GRAPH_OUTPUT_ELISION_OVERRIDE
deny TERMITE_DISABLE_OUTPUT_HOST_MIRROR_RESYNC
deny TERMITE_DISABLE_PAGED_KV

# Fixed-zero diagnostics may be installed by strict qualification but cannot
# be enabled by a product recipe environment.
allow-fixed TERMITE_DEBUG_DEVICE_GRAD_NORM 0

allow-presence TERMITE_METAL_DISABLE_GEMMA_GQA_ATTENTION_FUSION
allow-presence TERMITE_METAL_ENABLE_GEMMA_GQA_ATTENTION_FUSION
allow-presence TERMITE_GEMMA4_DISABLE_BATCHED_SPARSE_LOSS
allow-presence TERMITE_METAL_DISABLE_LORA_FORWARD_RANK1_FUSED

allow-uint-range TERMITE_GEMMA4_SPARSE_LOSS_CHUNK_ROWS 1 512
allow-uint TERMITE_METAL_LINEAR_CCE_TILE_VOCAB
allow-uint ANTFLY_GEMMA4_DPO_CHECKPOINT_LAYER_INTERVAL
allow-uint ANTFLY_GEMMA4_GRPO_MULTI_TOKEN_BACKWARD_MAX_BATCH
allow-uint ANTFLY_GEMMA4_GRPO_MULTI_TOKEN_MAX_BATCH

allow-bool TERMITE_GEMMA4_DISABLE_SPARSE_LOGITS_CROSS_ENTROPY
allow-bool TERMITE_METAL_DISABLE_LINEAR_CCE
allow-bool TERMITE_METAL_DISABLE_BF16_TILED32_M16
allow-bool TERMITE_METAL_DISABLE_BF16_SIMDGROUP_MM
allow-bool TERMITE_METAL_DISABLE_BF16_SIMDGROUP_M64
allow-bool TERMITE_METAL_DISABLE_BF16_FORWARD_SIMDGROUP_M64_PACKED
allow-bool TERMITE_METAL_DISABLE_BF16_SIMDGROUP_M64_PREFIX_TAIL
allow-bool TERMITE_METAL_DISABLE_BF16_BACKWARD_TILED32_M16
allow-bool TERMITE_METAL_DISABLE_BF16_BACKWARD_SMALL_ROWS
allow-bool TERMITE_METAL_DISABLE_BF16_BACKWARD_SIMDGROUP_MM
allow-bool TERMITE_METAL_DISABLE_BF16_BACKWARD_SIMDGROUP_M64
allow-bool TERMITE_METAL_DISABLE_BF16_BACKWARD_SIMDGROUP_M64_COALESCED
allow-bool TERMITE_METAL_DISABLE_BF16_BACKWARD_SIMDGROUP_M64_PACKED
allow-bool TERMITE_METAL_DISABLE_RMS_NORM_BACKWARD_SIMDGROUP
allow-bool TERMITE_METAL_DISABLE_RMS_NORM_BACKWARD_RESIDUAL_ADD_FUSION
allow-bool TERMITE_METAL_ENABLE_RMS_NORM_BACKWARD_RESIDUAL_ADD_FUSION
allow-bool TERMITE_METAL_ENABLE_RMS_NORM_GENERATED
allow-bool TERMITE_METAL_DISABLE_LINEAR_CCE_F16_GRAD
allow-bool TERMITE_METAL_DISABLE_LINEAR_CCE_LOGIT_CACHE
allow-bool TERMITE_METAL_DISABLE_LINEAR_CCE_F16_MPS_BACKWARD
allow-bool TERMITE_METAL_ENABLE_DENSE_MPS_LINEAR
allow-bool TERMITE_METAL_ENABLE_GEMMA4_BF16_MLP_FUSION
allow-bool TERMITE_METAL_DISABLE_GEMMA4_BF16_MLP_FUSION
allow-bool TERMITE_METAL_ENABLE_GEMMA4_BF16_GATE_UP_BACKWARD_INPUT_SUM
allow-bool TERMITE_METAL_DISABLE_GEMMA4_BF16_GATE_UP_BACKWARD_INPUT_SUM
allow-bool TERMITE_METAL_ENABLE_Q4_0_LINEAR_RMS_ADD_SUMSQ
