{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antfly.io/schemas/gemma4_oracle_publication.schema.json",
  "title": "Antfly Gemma4 oracle publication commit marker",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "files"],
  "properties": {
    "schema_version": { "const": "antfly_gemma4_oracle_publication/v1" },
    "status": { "const": "complete" },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!COMPLETE\\.json$).+$"
          },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
